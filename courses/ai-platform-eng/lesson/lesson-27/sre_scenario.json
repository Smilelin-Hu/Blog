        "target_alertnames": [
          "InferencePodLatencyHigh",
          "GPUHealthDegraded"
        ],
        "equal": [
          "cluster"
        ]
      }
    ]
  },
  "chaos_experiment": {
    "name": "assistant-pod-kill",
    "kind": "PodChaos",
    "action": "pod-kill",
    "mode": "one",
    "selector": {
      "namespaces": [
        "sre-lab"
      ],
      "label_selectors": {
        "app.kubernetes.io/name": "assistant-inference"
      }
    },
    "estimated_targets": 1,
    "duration_seconds": 60,
    "abort_signal": "SLOFastBurnOrNoReadyReplica",
    "production": false,
    "approval_id": null,
    "steady_state_verified": true
  },
  "chaos_policy": {
    "protected_namespaces": [
      "kube-system",
      "gpu-operator",
      "monitoring",
      "production"
    ],
    "maximum_chaos_targets": 1,
    "maximum_chaos_duration_seconds": 120
  },
  "remediation_policy": {
    "minimum_evidence_count": 2,
    "maximum_attempts_per_hour": 2,
    "cooldown_seconds": 300,
    "fault_actions": {
      "pod_crash_loop": {
        "name": "restart_single_workload_revision",
        "risk": "low",
        "requires_eviction": false,
        "requires_idle_gpu": false,
        "verification": "ready_replicas_and_sli_recover_for_10m",
        "rollback": "restore_previous_revision"
      },
      "gpu_xid_fault": {
        "name": "cordon_node_then_passive_health_check_and_idle_diagnostic",
        "risk": "containment",
        "requires_eviction": false,
        "requires_idle_gpu": true,
        "verification": "dcgm_health_clean_and_test_workload_passes",
        "rollback": "keep_node_cordoned_and_escalate_hardware_ticket"
      }
    }
  },
