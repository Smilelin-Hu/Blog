      "requires_gpudirect": true,
      "placement": "same-rack",
      "required_rails": [
        "rail-a",
        "rail-b"
      ],
      "expected_phase": "Allocated"
    },
    {
      "name": "ha-inference",
      "nodes": 2,
      "gpus_per_node": 1,
      "network": "primary-cni",
