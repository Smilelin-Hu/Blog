  "faults": [
    {
      "name": "secondary-network-missing",
      "type": "nad_missing",
      "expected_phase": "SandboxBlocked",
      "expected_reason": "NetworkAttachmentDefinitionUnavailable"
    },
    {
      "name": "end-to-end-mtu-mismatch",
      "type": "mtu_mismatch",
      "path_mtus": [
        9000,
        9000,
        1500,
        9000
      ],
      "payload_bytes": 4096,
      "expected_phase": "RunningDegraded",
      "expected_reason": "PathMTUMismatch"
    },
    {
      "name": "roce-congestion-control-disabled",
      "type": "roce_lossless_misconfigured",
      "pfc": false,
      "ecn": false,
      "expected_phase": "RunningDegraded",
      "expected_reason": "RoCECongestionControlMissing"
    },
    {
      "name": "rdma-device-not-advertised",
      "type": "rdma_missing",
      "expected_phase": "Pending",
      "expected_reason": "RDMAResourceUnavailable"
    },
    {
      "name": "gpudirect-peer-memory-unavailable",
      "type": "gpudirect_missing",
      "expected_phase": "CapabilityBlocked",
      "expected_reason": "GPUDirectPathUnavailable"
    },
    {
      "name": "gpu-nic-cross-numa",
      "type": "numa_mismatch",
      "gpu": 1,
      "nic": "mlx5_1",
      "expected_phase": "RunningDegraded",
      "expected_reason": "GPUNICNUMAMisaligned"
    },
    {
      "name": "second-rail-down",
      "type": "rail_down",
      "rail": "rail-b",
      "expected_phase": "PlacementBlocked",
      "expected_reason": "RequiredNetworkRailUnavailable"
    },
    {
      "name": "node-driver-generation-skew",
      "type": "driver_skew",
      "generations": [
        "validated-2026q3",
        "candidate-2026q4"
      ],
      "expected_phase": "Quarantined",
      "expected_reason": "NetworkDriverGenerationSkew"
    },
    {
      "name": "nccl-selects-unroutable-interface",
      "type": "interface_selection",
      "interfaces": {
        "eth0": "routable",
        "docker0": "unroutable"
      },
      "selected": "docker0",
      "expected_phase": "InitializationBlocked",
      "expected_reason": "SelectedInterfaceUnroutable"
    }
  ]
