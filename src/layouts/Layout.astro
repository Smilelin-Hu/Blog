---
import '@fontsource/inter';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/inter/700.css';
import '@fontsource/jetbrains-mono';
import 'katex/dist/katex.min.css';
import '../styles/global.css';
import ThemeToggle from '../components/ThemeToggle.astro';
import Search from '../components/Search.astro';
import CopyButton from '../components/CopyButton.astro';
import { SERIES } from '../utils/notes';
import { getPath } from '../utils/paths';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = '笔记课堂 - AI Infra / 系统 / 算法笔记',
  description = 'AI Infra、GPU 算子优化、大模型、Agent 与工程实践的系统笔记',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const currentPath = Astro.url.pathname;
const isActive = (path: string) => currentPath === getPath(path) || currentPath.startsWith(getPath(path) + '/');
---

<!doctype html>
<html lang="zh-CN" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={getPath('/brand/brand-mark.svg')} />
    <link rel="canonical" href={canonicalURL} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:site_name" content="术核AI · 笔记课堂" />
    <meta name="theme-color" content="#007aff" />
    <script is:inline>
      if (
        localStorage.getItem('color-theme') === 'dark' ||
        (!('color-theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)
      ) {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }
    </script>
  </head>

  <body class="bg-[#fafafa] dark:bg-[#0a0a0a] text-gray-900 dark:text-gray-100 min-h-screen flex flex-col font-sans transition-colors duration-300">
    <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100] focus:px-4 focus:py-2 focus:bg-[#007aff] focus:text-white focus:rounded-lg focus:text-sm focus:font-medium">
      跳到主要内容
    </a>

    <!-- Reading progress -->
    <div class="fixed top-0 left-0 right-0 h-0.5 z-[60] bg-transparent">
      <div id="reading-progress" class="h-full w-0 bg-gradient-to-r from-[#007aff] to-[#5ac8fa] transition-[width] duration-150"></div>
    </div>

    <!-- Header：术核AI（dxzyai.com）深色毛玻璃风格 -->
    <header id="site-header" class="fixed top-0 left-0 right-0 z-50 h-[58px] text-white backdrop-blur-xl border-b border-white/[0.08] transition-all duration-300" style="background: rgba(5,12,30,0.78);">
      <nav class="relative flex items-center justify-between h-full max-w-7xl mx-auto px-6">
        <span class="flex items-center gap-3">
          <a href="https://shuhe-ai.com" target="_blank" rel="noopener noreferrer" aria-label="术核AI 官网" class="cursor-pointer">
            <img src={getPath('/brand/logo-white.png')} alt="术核AI" class="h-7 w-auto" />
          </a>
          <a href={getPath('/')} class="hidden sm:inline text-[13px] font-medium text-gray-300 border-l border-white/15 pl-3 hover:text-white transition-colors cursor-pointer">笔记课堂</a>
        </span>

        <div class="hidden md:flex items-center gap-1">
          <a href={getPath('/')} class:list={['px-3 py-2 rounded-lg text-[13px] font-medium transition-colors cursor-pointer', currentPath === getPath('/') ? 'text-white bg-white/10' : 'text-gray-300 hover:text-white hover:bg-white/10']}>首页</a>
          <a href={getPath('/#series')} class="px-3 py-2 rounded-lg text-[13px] font-medium text-gray-300 hover:text-white hover:bg-white/10 transition-colors cursor-pointer">系列</a>
          <a href="https://github.com/swpucwf/Blog" target="_blank" rel="noopener noreferrer" class="px-3 py-2 rounded-lg text-[13px] font-medium text-gray-300 hover:text-white hover:bg-white/10 transition-colors cursor-pointer">GitHub</a>
        </div>

        <div class="flex items-center gap-2">
          <button
            id="search-trigger"
            class="hidden sm:flex items-center gap-2 px-3 py-1.5 rounded-lg border border-white/15 text-xs text-gray-300 hover:border-white/30 transition-colors cursor-pointer"
            aria-label="搜索"
          >
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z" />
            </svg>
            搜索
            <kbd class="px-1.5 py-0.5 rounded bg-white/10 text-[10px] font-mono">⌘K</kbd>
          </button>
          <ThemeToggle />
          <button id="mobile-menu-btn" class="md:hidden p-2 rounded-lg hover:bg-white/10 transition-colors text-gray-300 cursor-pointer" aria-label="菜单">
            <svg class="w-5 h-5 menu-open" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
            </svg>
            <svg class="w-5 h-5 menu-close hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>
      </nav>
    </header>

    <!-- Mobile menu -->
    <div id="mobile-menu-overlay" class="fixed inset-0 z-[70] bg-gray-900/50 backdrop-blur-sm opacity-0 pointer-events-none transition-opacity duration-300 md:hidden"></div>
    <div id="mobile-menu" class="fixed top-0 right-0 bottom-0 z-[80] w-80 max-w-[85vw] bg-white dark:bg-[#111] border-l border-gray-200 dark:border-white/[0.08] translate-x-full transition-transform duration-300 md:hidden overflow-y-auto">
      <div class="flex items-center justify-between p-5 border-b border-gray-100 dark:border-white/[0.06]">
        <span class="flex items-center gap-2">
          <a href="https://shuhe-ai.com" target="_blank" rel="noopener noreferrer" aria-label="术核AI 官网" class="cursor-pointer">
            <img src={getPath('/brand/logo-dark.png')} alt="术核AI" class="h-6 w-auto dark:hidden" />
            <img src={getPath('/brand/logo-white.png')} alt="术核AI" class="h-6 w-auto hidden dark:block" />
          </a>
          <span class="text-sm font-semibold text-gray-900 dark:text-white">系列目录</span>
        </span>
        <button id="mobile-menu-close" class="p-2 rounded-lg hover:bg-gray-100 dark:hover:bg-white/10 text-gray-500 cursor-pointer" aria-label="关闭">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
      <nav class="p-4 space-y-1">
        <a href={getPath('/')} class="mobile-nav-link block py-2.5 px-4 rounded-xl text-[13px] font-medium text-gray-700 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-white/[0.04] cursor-pointer">首页</a>
        {SERIES.map((s) => (
          <a href={getPath(`/source/${s.slug}/README`)} class="mobile-nav-link flex items-center gap-2 py-2.5 px-4 rounded-xl text-[13px] text-gray-600 dark:text-gray-400 hover:bg-gray-50 dark:hover:bg-white/[0.04] cursor-pointer">
            <span>{s.icon}</span>{s.label}
          </a>
        ))}
      </nav>
    </div>

    <!-- Main -->
    <main id="main-content" class="flex-1 pt-[58px]">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="border-t border-white/[0.06] py-8 mt-auto" style="background: #071122;">
      <div class="max-w-7xl mx-auto px-6 flex flex-col md:flex-row justify-between items-center gap-4">
        <span class="flex items-center gap-3">
          <a href="https://shuhe-ai.com" target="_blank" rel="noopener noreferrer" aria-label="术核AI 官网" class="cursor-pointer">
            <img src={getPath('/brand/logo-white.png')} alt="术核AI" class="h-6 w-auto" />
          </a>
          <p class="text-gray-500 text-xs">&copy; 2025-{new Date().getFullYear()} 笔记课堂 · swpucwf</p>
        </span>
        <p class="text-gray-500 text-xs">Built with Astro · 内容即笔记，工程即纪律</p>
        <div class="flex items-center gap-4">
          <a href="https://dxzyai.com/" target="_blank" rel="noopener noreferrer" class="text-gray-400 hover:text-white transition-colors text-xs cursor-pointer">术核AI</a>
          <a href="https://blog.csdn.net/weixin_42917352" target="_blank" rel="noopener noreferrer" class="text-gray-400 hover:text-white transition-colors text-xs cursor-pointer">CSDN</a>
          <a href="https://github.com/swpucwf/Blog" target="_blank" rel="noopener noreferrer" class="text-gray-400 hover:text-white transition-colors text-xs cursor-pointer">GitHub</a>
        </div>
      </div>
    </footer>

    <!-- Back to Top -->
    <button
      id="back-to-top"
      class="fixed bottom-8 right-8 w-11 h-11 bg-[#007aff] hover:bg-[#0062cc] text-white rounded-full shadow-lg opacity-0 pointer-events-none transition-all duration-300 z-50 flex items-center justify-center cursor-pointer"
      aria-label="回到顶部"
    >
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 10l7-7m0 0l7 7m-7-7v18" />
      </svg>
    </button>

    <script>
      const progressBar = document.getElementById('reading-progress');
      const backToTopBtn = document.getElementById('back-to-top');
      const header = document.getElementById('site-header');

      window.addEventListener('scroll', () => {
        const winScroll = document.body.scrollTop || document.documentElement.scrollTop;
        const height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
        const scrolled = height > 0 ? (winScroll / height) * 100 : 0;
        if (progressBar) progressBar.style.width = scrolled + '%';
        if (header) header.classList.toggle('is-scrolled', winScroll > 20);
        if (winScroll > 500) {
          backToTopBtn?.classList.remove('opacity-0', 'pointer-events-none');
          backToTopBtn?.classList.add('opacity-100', 'pointer-events-auto');
        } else {
          backToTopBtn?.classList.remove('opacity-100', 'pointer-events-auto');
          backToTopBtn?.classList.add('opacity-0', 'pointer-events-none');
        }
      });

      backToTopBtn?.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));

      // Mobile menu
      const mobileMenu = document.getElementById('mobile-menu');
      const mobileMenuOverlay = document.getElementById('mobile-menu-overlay');
      const menuIcon = document.getElementById('mobile-menu-btn');
      function openMenu() {
        mobileMenu?.classList.remove('translate-x-full');
        mobileMenuOverlay?.classList.remove('opacity-0', 'pointer-events-none');
        document.body.style.overflow = 'hidden';
        menuIcon?.querySelector('.menu-open')?.classList.add('hidden');
        menuIcon?.querySelector('.menu-close')?.classList.remove('hidden');
      }
      function closeMenu() {
        mobileMenu?.classList.add('translate-x-full');
        mobileMenuOverlay?.classList.add('opacity-0', 'pointer-events-none');
        document.body.style.overflow = '';
        menuIcon?.querySelector('.menu-open')?.classList.remove('hidden');
        menuIcon?.querySelector('.menu-close')?.classList.add('hidden');
      }
      document.getElementById('mobile-menu-btn')?.addEventListener('click', openMenu);
      document.getElementById('mobile-menu-close')?.addEventListener('click', closeMenu);
      mobileMenuOverlay?.addEventListener('click', closeMenu);
      document.querySelectorAll('.mobile-nav-link').forEach((l) => l.addEventListener('click', closeMenu));
      document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeMenu(); });

      // Search trigger
      document.getElementById('search-trigger')?.addEventListener('click', () => {
        document.dispatchEvent(new Event('open-search'));
      });

      // 图床防盗链：所有 img 加 no-referrer
      document.querySelectorAll('img').forEach((img) => img.setAttribute('referrerpolicy', 'no-referrer'));
    </script>

    <Search />
    <CopyButton />

    <!-- Mermaid：自托管 npm 依赖，避免 CDN 不可达 -->
    <script>
      import mermaid from 'mermaid';
      function initMermaid() {
        const isDark = document.documentElement.classList.contains('dark');
        mermaid.initialize({ startOnLoad: false, theme: isDark ? 'dark' : 'default', securityLevel: 'loose' });
        const selectors = 'pre[data-language="mermaid"], pre > code.language-mermaid';
        document.querySelectorAll(selectors).forEach((el) => {
          const pre = el.tagName === 'PRE' ? el : el.parentElement;
          const code = pre.querySelector('code') || pre;
          const div = document.createElement('div');
          div.className = 'mermaid';
          div.textContent = code.textContent;
          pre.replaceWith(div);
        });
        mermaid.run().then(() => {
          document.querySelectorAll('.mermaid svg').forEach((svg) => {
            const w = svg.viewBox.baseVal?.width;
            if (w) svg.style.minWidth = `${Math.round(w * 0.75)}px`;
          });
        });
      }
      initMermaid();
    </script>

    <!-- 图片点击放大 -->
    <script>
      import mediumZoom from 'medium-zoom';
      mediumZoom('.prose img', { margin: 24, background: 'rgba(0,0,0,0.7)' });
    </script>
  </body>
</html>