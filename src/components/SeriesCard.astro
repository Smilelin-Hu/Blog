---
interface Props {
  icon: string;
  title: string;
  description: string;
  href: string;
  count: number;
  num?: number;
  wip?: boolean;
}
const { icon, title, description, href, count, num, wip } = Astro.props;
---

<a
  href={href}
  class="group relative block p-6 rounded-2xl cursor-pointer transition-all duration-300 ease-[cubic-bezier(0.22,1,0.36,1)] bg-white dark:bg-white/[0.03] border border-gray-200 dark:border-white/[0.06] hover:border-gray-300 dark:hover:border-white/[0.12] hover:shadow-xl hover:-translate-y-1"
>
  <div class="absolute inset-0 rounded-2xl opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none" style="background: radial-gradient(ellipse at 50% 0%, rgba(0,122,255,0.12), transparent 70%);"></div>
  <div class="absolute top-0 left-6 right-6 h-[2px] rounded-full opacity-0 group-hover:opacity-100 transition-opacity duration-300" style="background: linear-gradient(90deg, #007aff, #5ac8fa);"></div>
  <div class="relative z-10">
    <div class="w-10 h-10 rounded-xl flex items-center justify-center mb-4 text-xl transition-transform duration-300 group-hover:scale-110" style="background: linear-gradient(135deg, rgba(0,122,255,0.12), rgba(90,200,250,0.12));">
      {icon}
    </div>
    <h3 class="text-base font-semibold text-gray-900 dark:text-white mb-2 group-hover:text-[#007aff] dark:group-hover:text-[#0a84ff] transition-colors">
      {num ? `${num}- ` : ''}{title}
      {wip && (
        <span class="ml-2 align-middle px-1.5 py-0.5 rounded bg-amber-500/15 text-amber-600 dark:text-amber-400 text-[10px] font-medium">待完成</span>
      )}
    </h3>
    <p class="text-[13px] leading-relaxed text-gray-500 dark:text-gray-400 mb-4 line-clamp-2">
      {description}
    </p>
    <span class="text-xs text-gray-400 dark:text-gray-500">{count} 篇笔记</span>
  </div>
</a>