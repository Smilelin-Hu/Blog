---
import { type CollectionEntry, render, getCollection } from 'astro:content';
import NotesSidebar from './NotesSidebar.astro';
import TableOfContents from './TableOfContents.astro';
import { buildTree, pagerOf, seriesOf, titleOf, dirOf, pathOf, visibleNotes } from '../utils/notes';
import { getPath } from '../utils/paths';

interface Props {
  entry: CollectionEntry<'notes'>;
}
const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const all = visibleNotes(await getCollection('notes'));
const tree = buildTree(all);
const series = seriesOf(entry);
const { prev, next, index } = pagerOf(entry, all);
const crumbs = dirOf(entry).split('/').filter(Boolean);
---

<div class="max-w-[1800px] mx-auto px-6 lg:pl-3 py-12 flex gap-8 xl:gap-10">
  <!-- Left Sidebar -->
  <aside class="hidden lg:block w-72 shrink-0">
    <div class="sticky top-24 max-h-[calc(100vh-8rem)] overflow-y-auto sidebar-scroll pr-2">
      <div class="flex items-center gap-2 mb-4">
        <div class="w-1 h-4 rounded-full bg-gradient-to-b from-[#007aff] to-[#5856D6]"></div>
        <span class="text-xs font-semibold text-gray-900 dark:text-gray-100 tracking-wide">目录</span>
      </div>
      <NotesSidebar nodes={tree} currentId={pathOf(entry)} />
    </div>
  </aside>

  <!-- Main Content -->
  <article class="flex-1 min-w-0">
    <header class="mb-8 pb-6 border-b border-gray-200 dark:border-white/[0.06]">
      <nav class="flex items-center gap-2 flex-wrap text-xs text-gray-400 dark:text-gray-500 mb-4">
        <a href={getPath('/')} class="hover:text-[#007aff] transition-colors">首页</a>
        <span>/</span>
        <a href={getPath(`/source/${series.slug}/README`)} class="hover:text-[#007aff] transition-colors">{series.label}</a>
        {crumbs.slice(1).map((c) => (
          <>
            <span>/</span>
            <span class="text-gray-500 dark:text-gray-400">{c}</span>
          </>
        ))}
      </nav>
      <span class="inline-flex items-center gap-1.5 px-3 py-1 bg-gray-100 dark:bg-white/[0.06] text-gray-600 dark:text-gray-400 text-xs font-medium rounded-md">
        {series.icon} {series.label}
      </span>
    </header>

    <div
      class="prose prose-gray dark:prose-invert max-w-none
        prose-headings:font-bold prose-headings:text-gray-900 dark:prose-headings:text-white
        prose-h1:text-3xl md:prose-h1:text-4xl prose-h1:leading-tight prose-h1:mb-6
        prose-h2:text-2xl prose-h2:mt-8 prose-h2:mb-3 prose-h2:pb-3 prose-h2:border-b prose-h2:border-gray-100 dark:prose-h2:border-white/[0.06]
        prose-h3:text-xl prose-h3:mt-6
        prose-p:leading-[1.85] prose-p:text-gray-600 dark:prose-p:text-gray-300
        prose-li:text-gray-600 dark:prose-li:text-gray-300
        prose-a:text-[#007aff] dark:prose-a:text-[#0a84ff] prose-a:no-underline prose-a:font-medium hover:prose-a:underline
        prose-strong:text-gray-900 dark:prose-strong:text-white
        prose-hr:border-gray-100 dark:prose-hr:border-white/[0.06]
        prose-blockquote:border-l-[#007aff] prose-blockquote:bg-blue-50/50 dark:prose-blockquote:bg-blue-900/10 prose-blockquote:rounded-r-lg prose-blockquote:py-1 prose-blockquote:not-italic
        prose-code:text-[#007aff] dark:prose-code:text-[#0a84ff] prose-code:bg-blue-50 dark:prose-code:bg-blue-900/20 prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded-md prose-code:text-[0.875em] prose-code:font-normal prose-code:before:content-none prose-code:after:content-none
        prose-img:rounded-xl prose-img:border prose-img:border-gray-200 dark:prose-img:border-white/[0.08] prose-img:shadow-sm"
    >
      <Content />
    </div>

    <!-- Prev/Next Navigation -->
    <nav class="mt-16 pt-8 border-t border-gray-200 dark:border-white/[0.06] grid grid-cols-2 gap-4">
      {prev ? (
        <a
          href={getPath(`/source/${pathOf(prev)}`)}
          class="group p-5 rounded-xl border border-gray-200 dark:border-white/[0.06] hover:border-gray-300 dark:hover:border-white/[0.12] hover:shadow-lg transition-all duration-300 cursor-pointer"
        >
          <span class="flex items-center gap-1.5 text-xs text-gray-400 dark:text-gray-500 mb-2">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
            </svg>
            上一篇
          </span>
          <span class="text-sm font-medium text-gray-900 dark:text-white group-hover:text-[#007aff] dark:group-hover:text-[#0a84ff] transition-colors duration-200">
            {titleOf(prev)}
          </span>
        </a>
      ) : <div />}
      {next ? (
        <a
          href={getPath(`/source/${pathOf(next)}`)}
          class="group p-5 rounded-xl border border-gray-200 dark:border-white/[0.06] hover:border-gray-300 dark:hover:border-white/[0.12] hover:shadow-lg transition-all duration-300 text-right cursor-pointer"
        >
          <span class="flex items-center justify-end gap-1.5 text-xs text-gray-400 dark:text-gray-500 mb-2">
            下一篇
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
            </svg>
          </span>
          <span class="text-sm font-medium text-gray-900 dark:text-white group-hover:text-[#007aff] dark:group-hover:text-[#0a84ff] transition-colors duration-200">
            {titleOf(next)}
          </span>
        </a>
      ) : <div />}
    </nav>
    {index && (
      <p class="mt-4 text-center">
        <a href={getPath(`/source/${pathOf(index)}`)} class="text-xs text-gray-400 dark:text-gray-500 hover:text-[#007aff] dark:hover:text-[#0a84ff] transition-colors">
          返回目录 · {titleOf(index)}
        </a>
      </p>
    )}
  </article>

  <!-- Right Sidebar: TOC -->
  <aside class="hidden xl:block">
    <TableOfContents headings={headings} />
  </aside>
</div>